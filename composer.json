{
    "name": "rupeshgondaliya/laravel-csv-studio",
    "description": "A beautiful, premium Laravel package for interactive multi-step CSV importing and exporting with live preview and inline editing.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Rupesh Gondaliya",
            "email": "gondaliyarupesh@gmail.com"
        }
    ],
    "require": {
        "php": "^8.0",
        "illuminate/support": "^9.0|^10.0|^11.0|^12.0"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0",
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "AestheticStudio\\CsvImporter\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "AestheticStudio\\CsvImporter\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "AestheticStudio\\CsvImporter\\CsvImporterServiceProvider"
            ]
        }
    }
}
